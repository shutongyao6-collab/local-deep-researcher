# Search backend: duckduckgo, tavily, perplexity, or searxng
SEARCH_API=duckduckgo
SEARXNG_URL=

# Optional paid-search credentials. Never commit real keys.
TAVILY_API_KEY=
PERPLEXITY_API_KEY=

# Local model provider: ollama or lmstudio
LLM_PROVIDER=ollama
LOCAL_LLM=qwen3.5:35b-a3b
LMSTUDIO_BASE_URL=http://localhost:1234/v1
OLLAMA_BASE_URL=http://localhost:11434

# Research controls
MAX_WEB_RESEARCH_LOOPS=2
FETCH_FULL_PAGE=True

# Optional comma-separated preferred domains, for example:
# PREFERRED_SOURCES=docs.langchain.com,github.com/langchain-ai
PREFERRED_SOURCES=
PREFERRED_LANGUAGE=python
